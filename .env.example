# ==============================================================================
# Gemini Browser Assistant - Backend Environment Variables
# Get your Google Gemini API key at: https://aistudio.google.com/app/apikey
# ==============================================================================

# Required: Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server Port (Default is 5000)
PORT=5000

# Optional: Gemini Model (gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash
